[Unit]
Description=Propose Metal Calendar discovery watchlist updates with open-weight model
After=ollama.service

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/metals-calendar/control
ExecStart=/usr/bin/bash -o pipefail -c 'git -C %h/.local/share/metals-calendar/control fetch origin main && git -C %h/.local/share/metals-calendar/control show origin/main:ops/ubuntu/run-watchlist-expansion.sh | /usr/bin/bash'
TimeoutStartSec=30min
